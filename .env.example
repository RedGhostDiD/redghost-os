# Copia este archivo a .env.local y completa los valores reales.
# .env.local NO se commitea (ya está en .gitignore).

# Genera con: node -e "console.log(require('crypto').randomBytes(33).toString('base64url'))"
AUTH_SECRET=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback URL: http://localhost:3000/api/auth/callback/github (dev)
#           o: https://tu-dominio.vercel.app/api/auth/callback/github (prod)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Única cuenta de GitHub que puede entrar a /admin
ADMIN_GITHUB_LOGIN=RedGhostDiD

# Fine-grained Personal Access Token (Settings > Developer settings > Personal access tokens > Fine-grained)
# Repository access: solo redghost-os. Permissions: Contents = Read and write.
GITHUB_COMMIT_TOKEN=

GITHUB_REPO_OWNER=RedGhostDiD
GITHUB_REPO_NAME=redghost-os
GITHUB_BRANCH=main
